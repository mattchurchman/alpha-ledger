{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha-ledger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-ledger-db",
      // created early by task 03 to unblock deploy; schema lives in ./migrations (task 06)
      "database_id": "74aa5a86-bf9b-43ff-8450-bd8bbc97f755",
      "migrations_dir": "migrations"
    }
  ]
}
